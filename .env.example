# TMDB API — მიიღეთ უფასოდ: https://www.themoviedb.org/settings/api
# გამოიყენეთ v3 "API Key" (მოკლე გასაღები), არა v4 bearer token.
TMDB_API_KEY=your_tmdb_v3_api_key_here

# ინტერფეისისა და მეტამონაცემების ენა
TMDB_LANGUAGE=ka-GE

# რეგიონი "სად ვნახო" პროვაიდერებისთვის
TMDB_REGION=GE

# ადმინის დაცული sync endpoint-ის token — დააგენერირეთ:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=change_me_to_a_random_secret
# ავტომატური სინქრონიზაციის ინტერვალი საათებში (ნაგულისხმევად 6)
SYNC_INTERVAL_HOURS=6

# Flask
SECRET_KEY=change_me_in_production
# გამოიყენეთ აბსოლუტური ბილიკი (forward-slash), რომ ბაზა ერთი და იგივე იყოს
# ნებისმიერი გაშვების საქაღალდიდან. შეცვალეთ თქვენს ბილიკზე:
DATABASE_URL=sqlite:///C:/Users/Asus/Desktop/gemovie-build/gemovie.db

# ---- ბექოფისი და მედია ----
# საცავი: local (საქაღალდე) ან r2 (Cloudflare R2 / S3-თავსებადი)
MEDIA_BACKEND=local
# local რეჟიმში: სად ინახება ატვირთული ფაილები.
# ლოკალურად ნაგულისხმევია <პროექტი>/media, პროდაქშენში კი აუცილებლად
# persistent volume უნდა იყოს, თორემ ატვირთული ფაილები deploy-ზე გაქრება:
#   MEDIA_ROOT=/data/media
MEDIA_ROOT=
# r2 რეჟიმისთვის:
MEDIA_R2_BUCKET=
MEDIA_R2_ENDPOINT=
MEDIA_R2_ACCESS_KEY=
MEDIA_R2_SECRET_KEY=
# CDN-ის საჯარო პრეფიქსი, მაგ. https://img.example.com (ცარიელი → ფაილს Flask გასცემს)
MEDIA_PUBLIC_BASE=
# ატვირთვის ლიმიტი მეგაბაიტებში
MAX_UPLOAD_MB=12
