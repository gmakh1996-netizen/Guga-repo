# TMDB API — მიიღეთ უფასოდ: https://www.themoviedb.org/settings/api
# გამოიყენეთ v3 "API Key" (მოკლე გასაღები), არა v4 bearer token.
TMDB_API_KEY=your_tmdb_v3_api_key_here

# ინტერფეისისა და მეტამონაცემების ენა
TMDB_LANGUAGE=ka-GE

# რეგიონი "სად ვნახო" პროვაიდერებისთვის
TMDB_REGION=GE

# ადმინის დაცული sync endpoint-ის token — დააგენერირეთ:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=change_me_to_a_random_secret
# ავტომატური სინქრონიზაციის ინტერვალი საათებში (ნაგულისხმევად 6)
SYNC_INTERVAL_HOURS=6

# Flask
SECRET_KEY=change_me_in_production
# გამოიყენეთ აბსოლუტური ბილიკი (forward-slash), რომ ბაზა ერთი და იგივე იყოს
# ნებისმიერი გაშვების საქაღალდიდან. შეცვალეთ თქვენს ბილიკზე:
DATABASE_URL=sqlite:///C:/Users/Asus/Desktop/gemovie-build/gemovie.db
